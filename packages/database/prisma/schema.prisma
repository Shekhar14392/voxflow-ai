generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ---------------- Identity ----------------

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String
  name            String
  phone           String?
  mfaEnabled      Boolean   @default(false)
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships OrganizationMember[]
  auditLogs   AuditLog[]
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  industry  String?
  timezone  String   @default("Asia/Kolkata")
  status    OrgStatus @default(ACTIVE)
  planId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plan          Plan?                @relation(fields: [planId], references: [id])
  members       OrganizationMember[]
  agents        Agent[]
  phoneNumbers  PhoneNumber[]
  calls         Call[]
  contacts      Contact[]
  leads         Lead[]
  appointments  Appointment[]
  knowledgeBases KnowledgeBase[]
  subscriptions Subscription[]
  usageRecords  UsageRecord[]
  apiKeys       ApiKey[]
  auditLogs     AuditLog[]
}

enum OrgStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

model Role {
  id             String   @id @default(uuid())
  organizationId String?
  name           String
  isSystemRole   Boolean  @default(false)

  members     OrganizationMember[]
  permissions RolePermission[]

  @@unique([organizationId, name])
}

model Permission {
  id          String @id @default(uuid())
  key         String @unique
  description String?

  roles RolePermission[]
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
}

model OrganizationMember {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  roleId         String
  status         String   @default("active")
  invitedAt      DateTime @default(now())
  joinedAt       DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
  role         Role         @relation(fields: [roleId], references: [id])

  @@unique([organizationId, userId])
}

// ---------------- Agents & telephony ----------------

model Agent {
  id                  String    @id @default(uuid())
  organizationId      String
  name                String
  description         String?
  businessName        String?
  businessDescription String?
  industry            String?
  role                String?
  systemInstructions  String    @db.Text
  greeting            String?
  fallbackMessage     String?
  voiceId             String?
  language            String    @default("en")
  allowedLanguages    String[]
  temperature         Float     @default(0.4)
  responseStyle       String?
  businessHours       Json?
  timezone            String    @default("Asia/Kolkata")
  recordingEnabled    Boolean   @default(true)
  state               AgentState @default(DRAFT)
  phoneNumberId       String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  organization  Organization    @relation(fields: [organizationId], references: [id])
  phoneNumber   PhoneNumber?    @relation(fields: [phoneNumberId], references: [id])
  calls         Call[]
  leads         Lead[]
  knowledgeBases KnowledgeBase[]
}

enum AgentState {
  DRAFT
  TESTING
  ACTIVE
  PAUSED
  ARCHIVED
}

model PhoneNumber {
  id               String   @id @default(uuid())
  organizationId   String
  number           String   @unique
  countryCode      String
  provider         String
  providerNumberId String?
  status           String   @default("active")
  createdAt        DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  agents       Agent[]
}

model Call {
  id             String   @id @default(uuid())
  organizationId String
  agentId        String
  contactId      String?
  leadId         String?
  direction      String
  status         String
  fromNumber     String
  toNumber       String
  startedAt      DateTime?
  answeredAt     DateTime?
  endedAt        DateTime?
  durationSeconds Int?
  recordingUrl   String?
  transcriptUrl  String?
  summary        String?
  sentiment      String?
  outcome        String?
  cost           Float?
  providerCallId String?
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  agent        Agent        @relation(fields: [agentId], references: [id])
}

// ---------------- CRM ----------------

model Contact {
  id             String   @id @default(uuid())
  organizationId String
  name           String?
  phone          String?
  email          String?
  tags           String[]
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id])
  leads        Lead[]
  appointments Appointment[]
}

model Lead {
  id             String   @id @default(uuid())
  organizationId String
  contactId      String?
  agentId        String?
  name           String?
  phone          String?
  email          String?
  company        String?
  source         String?
  status         String   @default("NEW")
  stage          String?
  score          Int?     @default(0)
  notes          String?
  assignedUserId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  contact      Contact?     @relation(fields: [contactId], references: [id])
  agent        Agent?       @relation(fields: [agentId], references: [id])
}

model Appointment {
  id              String   @id @default(uuid())
  organizationId  String
  contactId       String?
  service         String?
  scheduledAt     DateTime
  timezone        String   @default("Asia/Kolkata")
  durationMinutes Int      @default(30)
  status          String   @default("PENDING")
  notes           String?
  assignedStaffId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  contact      Contact?     @relation(fields: [contactId], references: [id])
}

// ---------------- Knowledge base / RAG ----------------

model KnowledgeBase {
  id             String   @id @default(uuid())
  organizationId String
  agentId        String?
  name           String
  status         String   @default("UPLOADING")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id])
  agent        Agent?             @relation(fields: [agentId], references: [id])
  documents    KnowledgeDocument[]
}

model KnowledgeDocument {
  id              String   @id @default(uuid())
  knowledgeBaseId String
  sourceType      String
  sourceUrl       String?
  rawTextRef      String?
  status          String   @default("PROCESSING")
  createdAt       DateTime @default(now())

  knowledgeBase KnowledgeBase   @relation(fields: [knowledgeBaseId], references: [id])
  chunks        KnowledgeChunk[]
}

model KnowledgeChunk {
  id                  String                 @id @default(uuid())
  knowledgeDocumentId String
  content             String                 @db.Text
  embedding           Unsupported("vector(1536)")?
  tokenCount          Int?
  createdAt           DateTime               @default(now())

  document KnowledgeDocument @relation(fields: [knowledgeDocumentId], references: [id])
}

// ---------------- Billing ----------------

model Plan {
  id                        String  @id @default(uuid())
  name                      String  @unique
  priceUsd                  Float
  maxAgents                 Int
  maxUsers                  Int
  maxPhoneNumbers           Int
  monthlyVoiceMinutes       Int
  monthlyOutboundMinutes    Int
  monthlyKnowledgeDocuments Int
  monthlyRagQueries         Int
  monthlyApiRequests        Int
  maxConcurrentCalls        Int
  recordingRetentionDays    Int
  featuresJson              Json?
  isActive                  Boolean @default(true)

  organizations Organization[]
  subscriptions Subscription[]
}

model Subscription {
  id                     String   @id @default(uuid())
  organizationId         String
  planId                 String
  status                 String   @default("trialing")
  providerSubscriptionId String?
  currentPeriodStart     DateTime @default(now())
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean  @default(false)

  organization Organization @relation(fields: [organizationId], references: [id])
  plan         Plan         @relation(fields: [planId], references: [id])
}

model UsageRecord {
  id             String   @id @default(uuid())
  organizationId String
  agentId        String?
  userId         String?
  type           String
  quantity       Float
  unit           String
  timestamp      DateTime @default(now())
  idempotencyKey String   @unique
  metadata       Json?

  organization Organization @relation(fields: [organizationId], references: [id])
}

model ApiKey {
  id           String    @id @default(uuid())
  organizationId String
  name         String
  hashedKey    String    @unique
  lastUsedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
}

// ---------------- Audit ----------------

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String?
  actorUserId    String?
  action         String
  targetType     String?
  targetId       String?
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id])
  actor        User?         @relation(fields: [actorUserId], references: [id])
}
