# ---- Core ----
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://voxflow:voxflow@localhost:5432/voxflow
REDIS_URL=redis://localhost:6379

# ---- Auth ----
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---- Provider mode ----
# Set to true to run the whole platform with zero real API keys.
USE_MOCK_PROVIDERS=true

# ---- LLM provider (real keys, only used when USE_MOCK_PROVIDERS=false) ----
LLM_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ---- STT / TTS ----
STT_PROVIDER=openai
TTS_PROVIDER=openai

# ---- Telephony ----
TELEPHONY_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY=

# ---- Payments ----
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=

# ---- Storage ----
STORAGE_PROVIDER=supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Web app ----
NEXT_PUBLIC_API_URL=http://localhost:4000
